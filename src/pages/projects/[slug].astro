---
import {
  Code2,
  ExternalLink,
  PlayCircle,
  X,
} from "@lucide/astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import ProjectVisual from "../../components/ProjectVisual.astro";
import EngineeringCaseStudy from "../../components/EngineeringCaseStudy.astro";
import { profile, projects } from "../../data";
import type { Project } from "../../types/project";
import { assetPath } from "../../utils/paths";

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props as { project: Project };
const title = `${project.title} | ${profile.name}`;
const description = project.summary;
const leadImage = project.media.find((item) => item.type === "image");
const demoEmbedUrl =
  project.demoVideo?.type === "youtube" && project.demoVideo.id.trim()
    ? `https://www.youtube-nocookie.com/embed/${project.demoVideo.id}?autoplay=1&rel=0&modestbranding=1`
    : project.demoVideo?.type === "google-drive" && project.demoVideo.id.trim()
      ? `https://drive.google.com/file/d/${project.demoVideo.id}/preview`
      : "";
const demoExternalUrl = project.demoVideo?.type === "google-drive"
  ? `https://drive.google.com/file/d/${project.demoVideo.id}/view`
  : `https://www.youtube.com/watch?v=${project.demoVideo?.id ?? ""}`;
const linkIcons = {
  GitHub: Code2,
  Demo: ExternalLink,
  Video: PlayCircle,
};
---

<BaseLayout title={title} description={description}>
  <Header />
  <main>
    <section class="relative border-b border-white/10 py-16 sm:py-20">
      <div
        class="absolute inset-0 bg-gradient-to-b from-blue-600/10 via-transparent to-violet-600/10"
      >
      </div>
      <div class="mx-auto w-full max-w-7xl px-5 sm:px-6 lg:px-8">
        <a
          class="relative text-sm font-semibold text-blue-300 underline decoration-blue-400/40 underline-offset-4 hover:text-white"
          href={assetPath("projects/")}
        >
          Back to projects
        </a>
        <div
          class="relative mt-8 grid gap-8 lg:grid-cols-2 lg:items-center"
        >
          <div class="min-w-0 lg:col-start-1 lg:row-start-1">
            <h1 class="text-4xl font-bold text-white sm:text-6xl">
              {project.title}
            </h1>
          </div>

          <div
            class="min-w-0 lg:col-start-2 lg:row-span-2 lg:row-start-1 lg:self-center"
          >
            <ProjectVisual
              title={project.title}
              stack={project.stack}
              accent={project.accent}
              image={leadImage?.src}
              imageAlt={leadImage?.alt}
            />
          </div>

          <div class="min-w-0 lg:col-start-1 lg:row-start-2">
            <p class="mt-3 text-base font-semibold text-blue-300">
              {project.role}
            </p>
            <p class="mt-5 max-w-2xl text-base leading-8 text-slate-400">
              {project.subtitle ?? project.summary}
            </p>
            <div class="mt-6 flex flex-wrap gap-3">
              {
                project.links.map((link) => {
                  const Icon =
                    linkIcons[link.label as keyof typeof linkIcons] ??
                    ExternalLink;
                  return (
                    <a
                      href={link.href}
                      target="_blank"
                      rel="noreferrer"
                      class="inline-flex min-h-11 items-center justify-center gap-2 rounded-xl border border-white/20 bg-white/10 px-4 py-2 text-sm font-semibold text-white transition hover:bg-white/20"
                    >
                      <Icon
                        class="h-4 w-4"
                        aria-hidden="true"
                        stroke-width={2}
                      />
                      {link.label}
                    </a>
                  );
                })
              }
              <button
                class="inline-flex min-h-11 items-center justify-center gap-2 rounded-xl border border-blue-400/40 bg-blue-500/20 px-4 py-2 text-sm font-semibold text-white transition enabled:hover:bg-blue-500/30 disabled:cursor-not-allowed disabled:opacity-40"
                type="button"
                disabled={!demoEmbedUrl}
                title={demoEmbedUrl ? "Watch project demo" : "Demo video unavailable"}
                data-demo-open
                data-demo-src={demoEmbedUrl}
              >
                <PlayCircle
                  class="h-4 w-4"
                  aria-hidden="true"
                  stroke-width={2}
                />
                Watch Demo
              </button>
            </div>
            {project.demoNote && (
              <p class="mt-3 max-w-2xl text-sm leading-6 text-slate-400">
                {project.demoNote}
              </p>
            )}
          </div>
        </div>
      </div>
    </section>

    <dialog
      class="video-dialog w-[min(96vw,64rem)] max-w-none overflow-hidden rounded-2xl border border-white/15 bg-[#080d24] p-0 text-white shadow-2xl shadow-black/50"
      data-demo-dialog
      aria-labelledby={`demo-dialog-title-${project.slug}`}
    >
      <div class="flex flex-col">
        <div
          class="flex items-center justify-between gap-4 border-b border-white/10 bg-[#0a0e27] px-4 py-3 sm:px-5"
        >
          <h2
            id={`demo-dialog-title-${project.slug}`}
            class="text-base font-bold text-white sm:text-lg"
          >
            {project.demoVideo?.title ?? `${project.title} Demo`}
          </h2>
          <button
            class="inline-flex h-10 w-10 flex-none items-center justify-center rounded-xl border border-white/15 bg-white/10 text-white transition hover:bg-white/20"
            type="button"
            aria-label="Close demo video"
            data-demo-close
          >
            <X class="h-5 w-5" aria-hidden="true" stroke-width={2} />
          </button>
        </div>
        {
          project.demoVideo ? (
            <div class="aspect-video bg-black">
              <iframe
                class="h-full w-full"
                title={project.demoVideo.title}
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                allowfullscreen
                loading="lazy"
                referrerpolicy="strict-origin-when-cross-origin"
                data-demo-frame
              />
            </div>
            <div class="flex justify-end border-t border-white/10 bg-[#0a0e27] px-4 py-3">
              <a
                class="text-sm font-semibold text-blue-300 underline decoration-blue-300/40 underline-offset-4 transition hover:text-white"
                href={demoExternalUrl}
                target="_blank"
                rel="noreferrer"
              >
                {project.demoVideo.type === "google-drive" ? "Open on Google Drive" : "Open on YouTube"}
              </a>
            </div>
          ) : (
            <div class="grid min-h-[20rem] place-items-center bg-[#0a0e27] px-6 py-12 text-center">
              <div class="max-w-md">
                <PlayCircle
                  class="mx-auto h-12 w-12 text-blue-300"
                  aria-hidden="true"
                  stroke-width={2}
                />
                <h3 class="mt-4 text-2xl font-bold text-white">
                  Demo video is ready to connect
                </h3>
                <p class="mt-3 text-sm leading-6 text-slate-400">
                  Add a YouTube video ID to this project in profile data, and
                  this dialog will play it here.
                </p>
              </div>
            </div>
          )
        }
      </div>
    </dialog>

    <section class="py-12 sm:py-14">
      <div class="mx-auto w-full max-w-[100rem] px-5 sm:px-6 lg:px-8">
        <EngineeringCaseStudy project={project} />
      </div>
    </section>
  </main>
  <footer class="border-t border-white/10 bg-blue-600/5 py-8">
    <div
      class="mx-auto flex max-w-6xl flex-col gap-2 px-5 text-sm text-slate-500 sm:flex-row sm:items-center sm:justify-between sm:px-6 lg:px-8"
    >
      <p>{profile.name}</p>
      <p>{profile.location}</p>
    </div>
  </footer>

  <script>
    const demoOpenButton = document.querySelector("[data-demo-open]");
    const demoDialog = document.querySelector("[data-demo-dialog]");
    const demoFrame = document.querySelector("[data-demo-frame]");
    const demoCloseButton = document.querySelector("[data-demo-close]");

    if (
      demoOpenButton instanceof HTMLButtonElement &&
      demoDialog instanceof HTMLDialogElement
    ) {
      function closeDemoDialog() {
        demoDialog.close();
      }

      demoOpenButton.addEventListener("click", () => {
        const src = demoOpenButton.dataset.demoSrc;

        if (demoOpenButton.disabled || !src) {
          return;
        }

        if (src && demoFrame instanceof HTMLIFrameElement) {
          const embedUrl = new URL(src);
          if (embedUrl.hostname === "www.youtube-nocookie.com") {
            embedUrl.searchParams.set("origin", window.location.origin);
            embedUrl.searchParams.set("widget_referrer", window.location.href);
          }
          demoFrame.src = embedUrl.toString();
        }

        demoDialog.showModal();
        document.documentElement.classList.add("overflow-hidden");
      });

      if (demoCloseButton instanceof HTMLButtonElement) {
        demoCloseButton.addEventListener("click", closeDemoDialog);
      }

      demoDialog.addEventListener("click", (event) => {
        if (event.target === demoDialog) {
          closeDemoDialog();
        }
      });

      demoDialog.addEventListener("close", () => {
        if (demoFrame instanceof HTMLIFrameElement) {
          demoFrame.removeAttribute("src");
        }
        document.documentElement.classList.remove("overflow-hidden");
      });
    }

  </script>
</BaseLayout>
