---
import { Mail, Send } from "@lucide/astro";
import { profile } from "../data/profile";
import { assetPath } from "../utils/paths";

const web3FormsAccessKey = import.meta.env.PUBLIC_WEB3FORMS_ACCESS_KEY ?? "";
const contactSource = "Portfolio Website (https://amiruhoradagoda.github.io/portfolio/)";
const contactEmailSubject = "New Portfolio Contact Message - Amiru Horadagoda";
---

<section id="contact" class="contact-section scroll-mt-24" aria-labelledby="contact-title">
  <div class="contact-container">
    <div class="contact-layout">
      <div class="contact-art" aria-hidden="true">
        <img src={assetPath("contact-illustration.png")} alt="" width="1122" height="1402" loading="lazy" />
      </div>
      <div class="contact-main">
        <header class="contact-heading">
          <p class="contact-eyebrow">Have something in mind?</p>
          <h2 id="contact-title">Let's <span>connect.</span></h2>
          <p>Have an opportunity, project, or idea to share? I'd be happy to hear from you.</p>
        </header>
      <form class="contact-form" action="https://api.web3forms.com/submit" method="post" data-contact-form>
        <input type="hidden" name="access_key" value={web3FormsAccessKey} />
        <input type="checkbox" name="botcheck" class="hidden" tabindex="-1" autocomplete="off" />
        <input type="hidden" name="redirect" value={assetPath("#contact")} />
        <input type="hidden" name="subject" value={contactEmailSubject} />
        <input type="hidden" name="Source" value={contactSource} />
        <label><span>Name <em>*</em></span><input type="text" name="Name" placeholder="Your name" autocomplete="name" required /></label>
        <label><span>Email <em>*</em></span><input type="email" name="email" placeholder="your.email@company.com" autocomplete="email" required /></label>
        <label><span>Subject <em>*</em></span><select name="Inquiry Subject" required><option value="" disabled selected>Select a subject...</option><option>Job opportunity</option><option>Freelance project</option><option>Collaboration</option><option>Open source</option><option>Other</option></select></label>
        <label><span>Message <em>*</em></span><textarea name="Message" placeholder="Tell me about the opportunity, project, or what you'd like to discuss..." minlength="50" aria-describedby="message-help message-count" required></textarea></label>
        <div class="message-help"><p id="message-help">Minimum 50 characters</p><p id="message-count" data-message-count hidden></p></div>
        <p class="hidden rounded-xl border px-4 py-3 text-sm font-semibold" data-contact-status role="status" aria-live="polite"></p>
        <div class="contact-actions"><button class="contact-send" type="submit" data-contact-submit><Send size={17} aria-hidden="true" /> Send Message</button><a class="email-direct" href={`mailto:${profile.email}`}>Email me directly <Mail size={16} aria-hidden="true" /></a></div>
      </form>
      </div>
    </div>
  </div>
</section>

<style>
  .contact-section { padding: var(--section-space) 24px 56px; color: var(--portfolio-text); border-top: 1px solid #ffffff0a; background: linear-gradient(180deg, #5b8cff03, transparent); }
  .contact-container { max-width: 1088px; margin: auto; }
  .contact-layout { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); align-items: center; gap: 64px; }
  .contact-art { position: relative; isolation: isolate; }
  .contact-art::before { content: ''; position: absolute; z-index: -1; inset: 18% 3% 12%; border-radius: 50%; background: radial-gradient(ellipse, #5b8cff1c, #8b5cf608 55%, transparent 72%); }
  .contact-art img { display: block; width: 100%; max-height: 620px; object-fit: contain; height: auto; }
  .contact-main { min-width: 0; }
  .contact-heading { margin-bottom: 26px; }
  .contact-eyebrow { text-transform: uppercase; letter-spacing: .12em; font-size: 12px; font-weight: 600; color: #93c5fd; margin-bottom: 12px; }
  .contact-heading h2 { font-size: clamp(38px, 4.8vw, 54px); font-weight: 800; line-height: 1.15; letter-spacing: -.035em; color: #f5f7ff; }
  .contact-heading h2 span { color: #a5b4fc; }
  .contact-heading > p:not([class]) { margin-top: 16px; max-width: 48ch; font-size: 16px; line-height: 1.7; color: var(--portfolio-muted); }
  .response-note { display: flex; align-items: center; gap: 7px; margin-top: 14px; color: #9aa7c5; font-size: 12px; }
  .contact-form { display: flex; flex-direction: column; gap: 18px; }
  .contact-form label { display: grid; gap: 8px; font-size: 13px; font-weight: 500; color: #e0e7ff; }
  .contact-form em { color: #93c5fd; font-style: normal; }
  .contact-form input:not([type=hidden]):not([type=checkbox]), .contact-form select, .contact-form textarea { width: 100%; min-width: 0; border: 1px solid #94a3b82e; border-radius: 8px; background: #11193680; color: #fff; padding: 12px 14px; font: inherit; font-size: 16px; font-weight: 400; outline: none; transition: border-color .2s, box-shadow .2s; }
  .contact-form input::placeholder, .contact-form textarea::placeholder { color: #8996b2; opacity: 1; }
  .contact-form select option { background: #111936; color: #fff; }
  .contact-form textarea { min-height: 130px; resize: vertical; line-height: 1.6; }
  .contact-form input:focus, .contact-form select:focus, .contact-form textarea:focus { border-color: #93c5fd; box-shadow: 0 0 0 3px #5b8cff15; }
  .message-help { display: flex; justify-content: space-between; gap: 12px; margin-top: -10px; color: var(--portfolio-muted); font-size: 12px; }
  [data-message-count].is-valid { color: #6ee7b7; }
  .contact-actions { display: flex; align-items: center; flex-wrap: wrap; gap: 12px 20px; }
  .contact-send { display: inline-flex; align-items: center; justify-content: center; gap: 9px; min-height: 46px; padding: 12px 20px; border-radius: 8px; border: 1px solid #93c5fd40; background: #3765b0; color: #fff; font-size: 14px; font-weight: 600; cursor: pointer; transition: background .2s; }
  .contact-send:hover { background: #4273bf; }
  .email-direct { display: inline-flex; align-items: center; gap: 8px; min-height: 44px; font-size: 13px; color: #b8c5df; transition: color .2s; }
  .email-direct:hover { color: #fff; }
  @media (max-width: 900px) { .contact-layout { gap: 32px; } }
  @media (max-width: 640px) { .contact-section { padding-inline: 20px; } .contact-layout { grid-template-columns: 1fr; gap: 28px; } .contact-main { grid-row: 1; } .contact-art { max-width: 280px; margin: auto; } .contact-art img { max-height: 300px; } }
</style>

<script>
  const contactForm = document.querySelector("[data-contact-form]");
  const contactStatus = document.querySelector("[data-contact-status]");
  const contactSubmit = document.querySelector("[data-contact-submit]");
  let contactStatusTimeout;
  const messageInput = document.querySelector('[data-contact-form] textarea');
  const messageCount = document.querySelector('[data-message-count]');
  function updateMessageCount() {
    if (messageInput instanceof HTMLTextAreaElement && messageCount instanceof HTMLElement) {
      const length = messageInput.value.length;
      messageCount.hidden = length === 0;
      messageCount.textContent = `${length} / 50`;
      messageCount.classList.toggle('is-valid', length >= 50);
    }
  }
  messageInput?.addEventListener('input', updateMessageCount);
  updateMessageCount();
  contactForm?.addEventListener('reset', () => window.setTimeout(updateMessageCount, 0));
  function setContactStatus(message, type) {
    if (!(contactStatus instanceof HTMLElement)) {
      return;
    }

    window.clearTimeout(contactStatusTimeout);
    contactStatus.textContent = message;
    contactStatus.classList.remove(
      "hidden",
      "border-blue-400/30",
      "bg-blue-500/10",
      "text-blue-100",
      "border-emerald-400/30",
      "bg-emerald-500/10",
      "text-emerald-100",
      "border-red-400/30",
      "bg-red-500/10",
      "text-red-100",
    );

    const statusClasses =
      type === "success"
        ? ["border-emerald-400/30", "bg-emerald-500/10", "text-emerald-100"]
        : type === "error"
          ? ["border-red-400/30", "bg-red-500/10", "text-red-100"]
          : ["border-blue-400/30", "bg-blue-500/10", "text-blue-100"];

    contactStatus.classList.add(...statusClasses);

    if (type === "success") {
      contactStatusTimeout = window.setTimeout(() => {
        contactStatus.classList.add("hidden");
        contactStatus.textContent = "";
      }, 5000);
    }
  }

  if (contactForm instanceof HTMLFormElement) {
    contactForm.addEventListener("submit", async (event) => {
      event.preventDefault();

      const formData = new FormData(contactForm);
      const accessKey = String(formData.get("access_key") ?? "");

      if (!accessKey) {
        setContactStatus("Contact form is not configured yet. Please email me directly.", "error");
        return;
      }

      if (contactSubmit instanceof HTMLButtonElement) {
        contactSubmit.disabled = true;
        contactSubmit.classList.add("cursor-not-allowed", "opacity-70");
      }

      setContactStatus("Sending message...", "loading");

      try {
        const response = await fetch("https://api.web3forms.com/submit", {
          method: "POST",
          headers: {
            Accept: "application/json",
            "Content-Type": "application/json",
          },
          body: JSON.stringify(Object.fromEntries(formData)),
        });

        const result = await response.json();

        if (response.ok && result.success) {
          contactForm.reset();
          setContactStatus("Message sent. I will get back to you soon.", "success");
          return;
        }

        setContactStatus(result.message || "Message could not be sent. Please try again.", "error");
      } catch {
        setContactStatus("Message could not be sent. Please check your connection and try again.", "error");
      } finally {
        if (contactSubmit instanceof HTMLButtonElement) {
          contactSubmit.disabled = false;
          contactSubmit.classList.remove("cursor-not-allowed", "opacity-70");
        }
      }
    });
  }
</script>
