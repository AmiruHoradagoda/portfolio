---
import { Code2, FileText, Network } from "@lucide/astro";
import type { Project } from "../data/profile";
import { getProjectCaseStudy } from "../utils/projectCaseStudy";
import { getTechLogo } from "../utils/techLogos";
import CaseStudyDiagrams from "./CaseStudyDiagrams.astro";

interface Props { project: Project }
const { project } = Astro.props;
const { details } = getProjectCaseStudy(project);
const tabs = [
  { id: "overview", label: "Overview", Icon: FileText },
  { id: "requirements", label: "Main Functional Requirements", Icon: Network },
  { id: "architecture", label: "Architecture & Design", Icon: Code2 },
];
---

<section class="overflow-hidden rounded-2xl border border-white/10 bg-[#101632] shadow-2xl shadow-blue-950/20" data-project-breakdown>
  <div class="border-b border-white/10 bg-white/[0.04] p-5 sm:p-6">
    <h2 class="text-3xl font-bold text-white">Engineering Case Study</h2>
  </div>
  <div class="grid min-w-0 lg:grid-cols-[18rem_1fr]">
    <div class="min-w-0 border-b border-white/10 bg-[#0a0e27]/55 p-4 lg:border-b-0 lg:border-r">
      <div class="grid grid-cols-2 gap-2 lg:grid-cols-1" role="tablist" aria-label="Engineering case study sections">
        {tabs.map(({ id, label, Icon }, index) => (
          <button class:list={["inline-flex min-h-12 min-w-0 items-center gap-2 rounded-xl border px-3 py-3 text-left text-sm font-semibold transition sm:gap-3", index === 0 ? "border-blue-400/50 bg-blue-500/20 text-white" : "border-white/10 bg-white/[0.04] text-slate-400 hover:border-white/25 hover:bg-white/10 hover:text-white"]}
            id={`${project.slug}-case-tab-${id}`} type="button" role="tab" aria-selected={index === 0 ? "true" : "false"}
            aria-controls={`${project.slug}-case-panel-${id}`} tabindex={index === 0 ? 0 : -1} data-case-tab={id}>
            <Icon class="h-4 w-4 flex-none text-blue-200" aria-hidden="true" stroke-width={2} />
            <span class="min-w-0 break-words">{label}</span>
          </button>
        ))}
      </div>
    </div>

    <div class="min-w-0 p-5 [overflow-wrap:anywhere] sm:p-6" data-case-content>
      <section id={`${project.slug}-case-panel-overview`} role="tabpanel" aria-labelledby={`${project.slug}-case-tab-overview`} tabindex="0" data-case-panel="overview">
        <p class="text-sm font-semibold uppercase tracking-[0.16em] text-blue-300">Background</p>
        <h3 class="mt-2 text-2xl font-bold text-white">{details.overviewHeading ?? "What this project solves"}</h3>
        {details.background.split(/\n\s*\n/).map((paragraph) => (
          <p class="mt-4 text-base leading-8 text-slate-300">
            {paragraph.split(/(\*\*.*?\*\*)/g).map((part) => part.startsWith("**") && part.endsWith("**")
              ? <strong class="font-semibold text-white">{part.slice(2, -2)}</strong> : part)}
          </p>
        ))}
        {details.overviewDiagrams.map((diagram, index) => (
          <CaseStudyDiagrams diagrams={[diagram]} idPrefix={`${project.slug}-overview-${index}`} />
        ))}
        <div class="mt-8">
          <h4 class="text-sm font-semibold uppercase tracking-[0.16em] text-slate-300">Technologies Used</h4>
          <div class="mt-4 flex flex-wrap gap-3">
            {project.stack.map((item) => (
              <span class="inline-flex min-h-11 max-w-full items-center gap-3 rounded-xl border border-blue-500/25 bg-blue-500/15 px-3 py-2 text-sm font-semibold text-blue-100">
                <span class="flex h-7 w-7 flex-none items-center justify-center rounded-lg bg-white p-1.5 shadow-sm"><img src={getTechLogo(item)} alt={`${item} logo`} class="h-full w-full object-contain" loading="lazy" /></span>
                <span class="min-w-0 break-words">{item}</span>
              </span>
            ))}
          </div>
        </div>

      </section>

      <section class="hidden" hidden id={`${project.slug}-case-panel-requirements`} role="tabpanel" aria-labelledby={`${project.slug}-case-tab-requirements`} tabindex="0" data-case-panel="requirements">
        <h3 class="text-2xl font-bold text-white">Main Functional Requirements</h3>
        {details.functionalRequirements.length > 0 && (
          <ul class="mt-6 divide-y divide-white/10 rounded-2xl border border-white/10 bg-[#0a0e27]/45">
            {details.functionalRequirements.map((item) => (
              <li class="px-4 py-5 sm:px-5">
                <h4 class="text-base font-bold text-blue-200">{item.area}</h4>
                <p class="mt-2 text-base leading-7 text-slate-300">{item.requirement}</p>
              </li>
            ))}
          </ul>
        )}
      </section>

      <section class="hidden" hidden id={`${project.slug}-case-panel-architecture`} role="tabpanel" aria-labelledby={`${project.slug}-case-tab-architecture`} tabindex="0" data-case-panel="architecture">
        <h3 class="text-2xl font-bold text-white">Architecture & Design</h3>
        {details.dataModelDiagrams.length > 0 && (
          <section class="mt-8" data-data-models>
            <h4 class="text-xl font-bold text-blue-200">Data Model / ER Design</h4>
            <CaseStudyDiagrams diagrams={details.dataModelDiagrams} idPrefix={`${project.slug}-data-models`} />
          </section>
        )}
        {details.systemDesigns.length > 0 && (
          <section class="mt-8" data-system-designs>
            <h4 class="text-xl font-bold text-blue-200">Main System Designs</h4>
            <div class="mt-4 divide-y divide-white/10 rounded-2xl border border-white/10 bg-[#0a0e27]/45">
              {details.systemDesigns.map((item, index) => (
                <details class="group" open={index === 0}>
                  <summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-4 py-4 transition hover:bg-white/[0.04] sm:px-5"><h5 class="text-base font-bold text-white">{item.title}</h5><span class="text-lg leading-none text-blue-200 transition group-open:rotate-45" aria-hidden="true">+</span></summary>
                  <div class="space-y-4 px-4 pb-5 sm:px-5">
                    {item.whereImplemented && <div><p class="text-xs font-semibold uppercase tracking-wider text-blue-300">Where implemented</p><p class="mt-2 text-base leading-7 text-slate-300">{item.whereImplemented}</p></div>}
                    <div><p class="text-xs font-semibold uppercase tracking-wider text-blue-300">How implemented</p><p class="mt-2 text-base leading-7 text-slate-300">{item.howImplemented}</p></div>
                    {item.whyUsed && <div><p class="text-xs font-semibold uppercase tracking-wider text-blue-300">Why used</p><p class="mt-2 text-base leading-7 text-slate-300">{item.whyUsed}</p></div>}
                    {item.diagram && <CaseStudyDiagrams diagrams={[item.diagram]} idPrefix={`${project.slug}-system-${index}`} />}
                  </div>
                </details>
              ))}
            </div>
          </section>
        )}
        {details.oopDesignPatterns.length > 0 && (
          <section class="mt-8" data-oop-patterns>
            <h4 class="text-xl font-bold text-blue-200">OOP Design Patterns</h4>
            <div class="mt-4 divide-y divide-white/10 rounded-2xl border border-white/10 bg-[#0a0e27]/45">
              {details.oopDesignPatterns.map((item, index) => (
                <details class="group" open={index === 0}>
                  <summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-4 py-4 transition hover:bg-white/[0.04] sm:px-5"><h5 class="text-base font-bold text-white">{item.pattern}</h5><span class="text-lg leading-none text-blue-200 transition group-open:rotate-45" aria-hidden="true">+</span></summary>
                  <div class="space-y-4 px-4 pb-5 sm:px-5">
                    <div><p class="text-xs font-semibold uppercase tracking-wider text-blue-300">Where implemented</p><p class="mt-2 text-base leading-7 text-slate-300">{item.where}</p></div>
                    {item.howImplemented && <div><p class="text-xs font-semibold uppercase tracking-wider text-blue-300">How implemented</p><p class="mt-2 text-base leading-7 text-slate-300">{item.howImplemented}</p></div>}
                    <div><p class="text-xs font-semibold uppercase tracking-wider text-blue-300">Why used</p><p class="mt-2 text-base leading-7 text-slate-300">{item.why}</p></div>
                    {item.diagram && <CaseStudyDiagrams diagrams={[item.diagram]} idPrefix={`${project.slug}-oop-${index}`} />}
                  </div>
                </details>
              ))}
            </div>
          </section>
        )}
      </section>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>("[data-project-breakdown]").forEach((breakdown) => {
    const tabs = Array.from(breakdown.querySelectorAll<HTMLButtonElement>("[data-case-tab]"));
    const panels = Array.from(breakdown.querySelectorAll<HTMLElement>("[data-case-panel]"));
    function selectTab(tab: HTMLButtonElement) {
      tabs.forEach((item) => {
        const selected = item === tab;
        item.setAttribute("aria-selected", String(selected));
        item.tabIndex = selected ? 0 : -1;
        ["border-blue-400/50", "bg-blue-500/20", "text-white"].forEach((name) => item.classList.toggle(name, selected));
        ["border-white/10", "bg-white/[0.04]", "text-slate-400"].forEach((name) => item.classList.toggle(name, !selected));
      });
      panels.forEach((panel) => {
        panel.hidden = panel.dataset.casePanel !== tab.dataset.caseTab;
        panel.classList.toggle("hidden", panel.hidden);
      });
    }
    tabs.forEach((tab, index) => {
      tab.addEventListener("click", () => selectTab(tab));
      tab.addEventListener("keydown", (event) => {
        if (!["ArrowLeft", "ArrowRight", "ArrowUp", "ArrowDown", "Home", "End"].includes(event.key)) return;
        event.preventDefault();
        const nextIndex = event.key === "Home" ? 0 : event.key === "End" ? tabs.length - 1 : (index + (["ArrowRight", "ArrowDown"].includes(event.key) ? 1 : -1) + tabs.length) % tabs.length;
        selectTab(tabs[nextIndex]);
        tabs[nextIndex].focus();
      });
    });
  });
</script>
