---
import { ArrowUpRight, BriefcaseBusiness, GraduationCap } from "@lucide/astro";
import { education, experience } from "../data";
import { assetPath } from "../utils/paths";
---

<section
  id="experience"
  class="professional-journey scroll-mt-24"
  aria-labelledby="professional-journey-title"
>
  <div class="mx-auto max-w-6xl px-5 sm:px-6 lg:px-8">
    <header class="journey-heading">
      <h2 id="professional-journey-title">Professional Journey</h2>
      <p>
        A snapshot of my professional experience, research work, and educational
        background.
      </p>
    </header>

    <div class="journey-columns">
      <section
        class="journey-panel work-panel"
        aria-labelledby="work-timeline-title"
      >
        <header class="panel-heading">
          <span class="panel-icon"
            ><BriefcaseBusiness size={25} aria-hidden="true" /></span
          >
          <h3 id="work-timeline-title">Work Experience</h3>
        </header>
        <ol class="journey-timeline">
          {
            experience.map((item) => (
              <li class="timeline-entry">
                <p class="timeline-date">{item.period}</p>
                <h4>{item.role}</h4>
                <p class="timeline-institution">{item.company}</p>
                <p class="timeline-meta">
                  {item.department} · {item.duration}
                </p>
                <p class="timeline-project">{item.project}</p>
                <ul class="work-highlights">
                  {(
                    item.contributions
                      ?.slice(0, 3)
                      .map((contribution) => contribution.description) ??
                    item.highlights.slice(0, 3)
                  ).map((highlight) => (
                    <li>{highlight}</li>
                  ))}
                </ul>
              </li>
            ))
          }
        </ol>
      </section>

      <section
        class="journey-panel education-panel"
        aria-labelledby="education-timeline-title"
      >
        <header class="panel-heading">
          <span class="panel-icon"
            ><GraduationCap size={27} aria-hidden="true" /></span
          >
          <h3 id="education-timeline-title">Education</h3>
        </header>
        <ol class="journey-timeline">
          {
            education.map((item) => (
              <li class="timeline-entry">
                <p class="timeline-date">{item.period}</p>
                <h4>{item.degree}</h4>
                <p class="timeline-institution">{item.institution}</p>
                {"result" in item && item.result && (
                  <p class="education-result">{item.result}</p>
                )}
                <ul class="coursework" aria-label="Areas of study">
                  {item.coursework.map((course) => (
                    <li>{course}</li>
                  ))}
                </ul>
              </li>
            ))
          }
        </ol>
      </section>
    </div>

    <div class="journey-more">
      <a href={assetPath("journey/")}
        >Explore my full journey <ArrowUpRight
          size={17}
          aria-hidden="true"
        /></a
      >
    </div>
  </div>
</section>

<style>
  .professional-journey {
    padding-block: 72px;
  }
  .journey-heading {
    max-width: 720px;
    margin: 0 auto 42px;
    text-align: center;
  }
  .journey-heading h2 {
    margin-top: 12px;
    font-size: clamp(32px, 4.6vw, 48px);
    line-height: 1.15;
    letter-spacing: -0.035em;
    font-weight: 750;
    color: #60a5fa;
    background: linear-gradient(100deg, #3b82f6 15%, #06b6d4 90%);
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  .journey-heading > p:last-child {
    margin-top: 18px;
    color: var(--portfolio-muted, #94a3b8);
    font-size: 16px;
    line-height: 1.75;
  }
  .journey-columns {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
  }
  .journey-panel {
    min-width: 0;
    padding: 30px;
    border: 1px solid var(--portfolio-border, #ffffff15);
    border-radius: 20px;
    background: linear-gradient(140deg, #ffffff04, #ffffff01);
    --timeline-accent: #60a5fa;
    --timeline-line: #3b82f638;
  }
  .education-panel {
    --timeline-accent: #22d3ee;
    --timeline-line: #06b6d438;
  }
  .panel-heading {
    display: flex;
    align-items: center;
    gap: 15px;
    margin-bottom: 30px;
  }
  .panel-icon {
    display: grid;
    place-items: center;
    width: 50px;
    height: 50px;
    flex-shrink: 0;
    border-radius: 14px;
    color: white;
    background: linear-gradient(125deg, #2563eb, #06b6d4);
  }
  .education-panel .panel-icon {
    background: linear-gradient(125deg, #06b6d4, #2563eb);
  }
  .panel-heading h3 {
    color: #f8fafc;
    font-size: clamp(21px, 2.2vw, 25px);
    font-weight: 700;
    letter-spacing: -0.025em;
    line-height: 1.3;
  }
  .journey-timeline {
    list-style: none;
    margin-left: 8px;
    padding-left: 26px;
    border-left: 1px solid var(--timeline-line);
  }
  .timeline-entry {
    position: relative;
    padding-bottom: 30px;
    overflow-wrap: anywhere;
  }
  .timeline-entry:last-child {
    padding-bottom: 2px;
  }
  .timeline-entry::before {
    content: "";
    position: absolute;
    left: -34px;
    top: 3px;
    width: 15px;
    height: 15px;
    border-radius: 50%;
    border: 2px solid var(--timeline-accent);
    background: var(--portfolio-bg, #0a0e27);
  }
  .timeline-date {
    color: var(--timeline-accent);
    font-size: 13px;
    font-weight: 650;
    line-height: 1.6;
  }
  .timeline-entry h4 {
    margin-top: 10px;
    font-size: 18px;
    line-height: 1.45;
    font-weight: 700;
    color: #f1f5f9;
    letter-spacing: -0.015em;
  }
  .timeline-institution {
    margin-top: 6px;
    font-size: 15px;
    line-height: 1.65;
    color: #a8b6ce;
  }
  .timeline-meta {
    margin-top: 5px;
    color: var(--portfolio-muted, #94a3b8);
    font-size: 12px;
    line-height: 1.7;
  }
  .timeline-project {
    margin-top: 17px;
    color: #cbd5e1;
    font-size: 14px;
    font-weight: 600;
    line-height: 1.6;
  }
  .work-highlights {
    list-style: disc;
    padding-left: 17px;
    margin-top: 12px;
    display: grid;
    gap: 12px;
    color: var(--portfolio-muted, #94a3b8);
    font-size: 14px;
    line-height: 1.8;
  }
  .work-highlights li::marker {
    color: var(--timeline-accent);
  }
  .coursework {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
    margin-top: 13px;
    list-style: none;
  }
  .coursework li {
    border-radius: 999px;
    background: #06b6d40c;
    border: 1px solid #06b6d414;
    padding: 4px 10px;
    color: #67d8e8;
    font-size: 11px;
    line-height: 1.6;
  }
  .education-result {
    margin-top: 8px;
    color: #67d8e8;
    font-size: 13px;
    font-weight: 600;
  }
  .journey-more {
    margin-top: 28px;
    text-align: center;
  }
  .journey-more a {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding-block: 8px;
    color: #93c5fd;
    font-size: 14px;
    font-weight: 600;
    text-decoration: underline;
    text-decoration-color: #60a5fa40;
    text-underline-offset: 5px;
    transition: color 150ms;
  }
  .journey-more a:hover {
    color: white;
  }
  @media (max-width: 850px) {
    .journey-columns {
      grid-template-columns: minmax(0, 1fr);
    }
    .professional-journey {
      padding-block: 56px;
    }
  }
  @media (max-width: 480px) {
    .journey-panel {
      padding: 24px 20px;
    }
    .panel-heading {
      gap: 12px;
    }
    .panel-icon {
      width: 44px;
      height: 44px;
      border-radius: 12px;
    }
    .journey-timeline {
      padding-left: 22px;
    }
    .timeline-entry::before {
      left: -30px;
    }
  }
</style>
