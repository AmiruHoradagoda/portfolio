---
import { BrainCircuit, Database, Workflow, FileCode, Network, Cable } from "@lucide/astro";
import { skillTabs } from "../data/profile";
import { getTechLogo } from "../utils/techLogos";
const conceptIcons = { "REST APIs": Cable, "Microservices": Network, "LLM / RAG": BrainCircuit, "ETL / ELT": Workflow, "Data Warehousing": Database, "Apache Avro": FileCode };
const logoAliases = { "HTML & CSS": "HTML", "Node.js / Express.js": "Node.js" };
---

<div class="w-full" data-skill-tabs>
  <div class="skill-tabs" role="tablist" aria-label="Skill categories">
    {skillTabs.map((tab, index) => <button type="button" role="tab" tabindex={index === 0 ? 0 : -1} aria-selected={index === 0 ? "true" : "false"} aria-controls={`skill-panel-${tab.id}`} id={`skill-tab-${tab.id}`} data-skill-tab={tab.id}>{tab.label}</button>)}
  </div>
  {skillTabs.map((tab, index) => <section id={`skill-panel-${tab.id}`} role="tabpanel" tabindex="0" aria-labelledby={`skill-tab-${tab.id}`} hidden={index !== 0} data-skill-panel={tab.id}>
    <div class="skill-grid">
      {tab.items.map(item => {
        const Icon = conceptIcons[item.name as keyof typeof conceptIcons];
        const logo = getTechLogo(logoAliases[item.name as keyof typeof logoAliases] ?? item.name);
        return <div class="skill-tile">
          <div class="skill-logo">
            {Icon ? <Icon size={39} stroke-width={1.5} aria-hidden="true" /> : <img src={logo} alt="" width="44" height="44" loading="lazy" />}
          </div>
          <h3>{item.name}</h3>
          <span class:list={["confidence", item.confidence.toLowerCase()]}>{item.confidence.toUpperCase()}</span>
        </div>;
      })}
    </div>
  </section>)}
</div>

<style>
  .skill-tabs { display: flex; flex-wrap: wrap; justify-content: center; gap: 12px; border-bottom: 1px solid #ffffff1a; padding-bottom: 24px; margin-bottom: 28px; }
  .skill-tabs button { min-height: 40px; border-radius: 8px; padding: 8px 16px; color: var(--portfolio-muted); font-size: 14px; font-weight: 600; cursor: pointer; transition: color .2s, background .2s; }
  .skill-tabs button:hover { background: #ffffff10; color: #fff; }
  .skill-tabs button[aria-selected="true"] { background: #ffffff1a; color: #93c5fd; box-shadow: 0 0 0 1px #60a5fa66; }
  .skill-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 160px)); justify-content: center; gap: 20px; margin-top: 30px; }
  .skill-tile { display: flex; flex-direction: column; align-items: center; text-align: center; padding: 20px 10px 16px; border: 1px solid #ffffff0c; border-radius: 12px; background: #ffffff03; }
  .skill-logo { display: grid; place-items: center; flex-shrink: 0; width: 64px; height: 64px; border-radius: 12px; background: #fff; color: #334155; box-shadow: 0 0 0 1px #ffffff1a; transition: transform .2s; }
  .skill-logo img { width: 44px; height: 44px; object-fit: contain; }
  .skill-tile:hover .skill-logo { transform: translateY(-4px); }
  .skill-tile h3 { display: flex; align-items: center; justify-content: center; width: 100%; min-height: 63px; margin: 14px 0 12px; color: #fff; font-size: 15px; line-height: 21px; font-weight: 600; }
  .confidence { display: inline-flex; align-items: center; justify-content: center; margin-top: auto; border: 1px solid; border-radius: 999px; padding: 6px 10px; font-size: 12px; line-height: 16px; font-weight: 600; white-space: nowrap; }
  .proficient { color: #bfdbfe; background: #2563eb33; border-color: #60a5fa66; }
  .intermediate { color: #ddd6fe; background: #7c3aed29; border-color: #a78bfa55; }
  .familiar { color: #cbd5e1; background: #94a3b81a; border-color: #94a3b84d; }
  @media (max-width: 480px) { .skill-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; } .skill-tabs { gap: 6px; } .skill-tabs button { font-size: 12px; padding-inline: 12px; } }
</style>

<script>
  document.querySelectorAll('[data-skill-tabs]').forEach(root => {
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-skill-tab]'));
    const panels = Array.from(root.querySelectorAll<HTMLElement>('[data-skill-panel]'));
    function selectTab(id: string | undefined) {
      tabs.forEach(tab => {
        const selected = tab.dataset.skillTab === id;
        tab.setAttribute('aria-selected', String(selected));
        tab.tabIndex = selected ? 0 : -1;
      });
      panels.forEach(panel => { panel.hidden = panel.dataset.skillPanel !== id; });
    }
    tabs.forEach((tab, index) => {
      tab.addEventListener('click', () => selectTab(tab.dataset.skillTab));
      tab.addEventListener('keydown', event => {
        const next = event.key === 'ArrowRight' ? (index + 1) % tabs.length
          : event.key === 'ArrowLeft' ? (index - 1 + tabs.length) % tabs.length
          : event.key === 'Home' ? 0 : event.key === 'End' ? tabs.length - 1 : -1;
        if (next < 0) return;
        event.preventDefault();
        selectTab(tabs[next].dataset.skillTab);
        tabs[next].focus();
      });
    });
  });
</script>
