---
import { ArrowDown } from "@lucide/astro";
import { profile } from "../data/profile";
import { assetPath } from "../utils/paths";
const githubUrl = profile.links.find(link => link.label === "GitHub")?.href;
const linkedinUrl = profile.links.find(link => link.label === "LinkedIn")?.href;
---
<section class="hero-section relative overflow-hidden px-5 text-white sm:px-6 lg:px-8" aria-labelledby="hero-title">
  <div class="hero-grid mx-auto grid max-w-6xl">
    <div class="hero-copy">
      <p class="eyebrow hero-tagline">Ready to contribute</p>
      <h1 id="hero-title"><span class="hero-greeting">Hi, I’m</span> <span class="hero-name">Amiru Horadagoda</span></h1>
      <p class="hero-role">Building software that turns ideas into working systems.</p>
      <div class="career-focus">
        <p class="focus-label">Focus areas</p>
        <ul class="focus-list" aria-label="Focus areas"><li>Backend Engineering</li><li>Full-Stack</li><li>Cloud &amp; DevOps</li><li>AI/Data</li></ul>
      </div>
      <p class="hero-description">Computer Engineering graduate focused on building reliable, practical software systems.</p>
      <div class="hero-actions">
        <a href="#featured-projects" class="primary-action"><ArrowDown size={19} aria-hidden="true" /> View Projects</a>
        <a href={githubUrl} class="secondary-action"><svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 22v-4c-4 1-4-2-6-3m12 7v-4c0-1-.3-2-1-2.5 4-.5 6-2 6-6 0-1.5-.5-2.5-1.5-3.5.3-1 .3-2.5-.2-3.5-2 0-3.5 1-4 1.5a13 13 0 0 0-5 0C8.5 3.5 7 2.5 5 2.5c-.5 1-.5 2.5-.2 3.5C3.8 7 3.3 8 3.3 9.5c0 4 2 5.5 6 6-.7.5-1 1.5-1 2.5"/></svg> GitHub Profile</a>
        <a href={linkedinUrl} class="secondary-action" target="_blank" rel="noopener noreferrer"><svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><rect x="3" y="8" width="4" height="13" rx=".5"/><circle cx="5" cy="4" r="2"/><path d="M11 21V8h4v2c3-4 7-2 7 3v8h-4v-7c0-3-3-3-3 0v7z"/></svg> LinkedIn</a>
      </div>
    </div>
    <div class="hero-portrait">
      <div class="portrait-card">
        <img src={assetPath("amiru-portrait-cutout.png")} alt={profile.name} width="1144" height="1375" loading="eager" fetchpriority="high" />
      </div>

    </div>
  </div>
</section>

<style>
  .hero-grid { grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr); align-items: center; gap: 52px; min-height: auto; padding-top: clamp(64px, 8vw, 104px); padding-bottom: 48px; }
  .hero-copy { min-width: 0; animation: hero-enter 650ms ease-out both; }
  .hero-tagline { margin-bottom: 20px; }
  h1 { font-size: var(--type-hero); font-weight: 800; line-height: 1.05; letter-spacing: -.045em; }
  .hero-role { margin-top: 26px; max-width: 32ch; font-family: var(--font-heading); color: #e0e7ff; font-size: clamp(22px, 2.4vw, 28px); font-weight: 600; line-height: 1.4; }
  .career-focus { display: flex; flex-direction: column; align-items: flex-start; gap: 6px; margin-top: 24px; font-size: 16px; line-height: 1.6; color: #cbd5e1; }
  .focus-label { color: var(--portfolio-muted); font-size: 12px; font-weight: 600; letter-spacing: .12em; text-transform: uppercase; }
  .focus-list { display: flex; flex-wrap: wrap; gap: 8px; max-width: 62ch; padding: 0; margin: 4px 0 0; list-style: none; color: #bfdbfe; font-size: 14px; line-height: 1.5; font-weight: 500; }
  .focus-list li { padding: 6px 11px; border: 1px solid rgb(147 197 253 / 18%); border-radius: 7px; background: rgb(91 140 255 / 5%); }
  .hero-description { max-width: 62ch; margin-top: 22px; color: var(--portfolio-muted); font-size: var(--type-body-lg); line-height: 1.75; }
  .hero-actions { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; margin-top: 32px; max-width: 590px; }
  .hero-actions a { min-height: 48px; padding: 12px 10px; border-radius: 9px; font-size: 13px; gap: 8px; white-space: nowrap; }
  .hero-actions :global(svg) { flex-shrink: 0; width: 17px; height: 17px; }
  .hero-actions :global(.primary-action) { background: #3765b0; border: 1px solid #6b92cf70; color: #fff; }
  .hero-actions :global(.primary-action:hover) { background: #4273bf; border-color: #93c5fd90; }
  .hero-actions :global(.secondary-action) { background: transparent; color: #cbd5e1; border-color: #ffffff25; }
  .hero-actions :global(.secondary-action:hover) { background: transparent; border-color: #93c5fd80; color: #fff; }
  .hero-contact { display: inline-flex; align-items: center; justify-content: center; gap: 10px; padding: 12px 16px; color: var(--portfolio-muted); font-size: 14px; font-weight: 500; transition: color .2s; }
  .hero-contact:hover { color: #93c5fd; }
  .hero-greeting { display: block; margin-bottom: 10px; font-size: .62em; font-weight: 700; color: #e0e7ff; letter-spacing: -.025em; }
  .hero-portrait { position: relative; width: 100%; align-self: center; animation: portrait-enter 650ms 100ms ease-out both; }
  .hero-portrait::before { content: ''; position: absolute; inset: 12% -8% -6%; z-index: -1; background: radial-gradient(ellipse, rgb(91 140 255 / 12%), transparent 72%); pointer-events: none; }
  .portrait-card { position: relative; isolation: isolate; width: 100%; padding-top: 8px; }
  .portrait-card::before { content: ''; position: absolute; inset: 18% 0 0; z-index: -1; border: 1px solid transparent; border-radius: 12px; background: radial-gradient(ellipse at 48% 28%, #d8e0ec 0%, #acb9cc 48%, #8295b0 100%) padding-box, linear-gradient(135deg, #bfdbfe, #a78bfa 55%, #5b8cff) border-box; box-shadow: 0 20px 45px rgb(2 6 23 / 30%), 0 0 28px rgb(91 140 255 / 10%); }
  .portrait-card img { display: block; width: 100%; height: auto; border-radius: 0 0 12px 12px; filter: drop-shadow(0 8px 10px rgb(15 23 42 / 20%)); }
  @keyframes hero-enter { from { opacity: 0; transform: translateY(18px); } to { opacity: 1; transform: translateY(0); } }
  @keyframes portrait-enter { from { opacity: 0; transform: translateY(15px) scale(.98); } to { opacity: 1; transform: translateY(0) scale(1); } }
  @media (max-width: 1023px) { .hero-grid { grid-template-columns: minmax(0, 1fr) 290px; gap: 32px; } }
  @media (max-width: 767px) { .hero-grid { grid-template-columns: 1fr; gap: 48px; padding-top: 56px; padding-bottom: 40px; } .hero-portrait { max-width: 340px; margin: 0 auto; } }
  @media (min-width: 768px) and (max-width: 1023px) { .hero-actions { grid-template-columns: repeat(2, minmax(0, 1fr)); } .hero-actions :global(.primary-action) { grid-column: 1 / -1; } }
  @media (max-width: 480px) { .hero-actions { grid-template-columns: repeat(2, minmax(0, 1fr)); } .hero-actions :global(.primary-action) { grid-column: 1 / -1; } }
  @media (prefers-reduced-motion: reduce) { .hero-copy, .hero-portrait { animation: none; } }
</style>
