---
import { Download, Menu, X } from "@lucide/astro";
import { profile } from "../data/profile";
import { assetPath } from "../utils/paths";

const navItems = [
  { label: "Home", href: assetPath("") },
  { label: "About", href: assetPath("#about") },
  { label: "Skills", href: assetPath("#skills") },
  { label: "Projects", href: assetPath("projects/") },
  { label: "Journey", href: assetPath("journey/") },
  { label: "Contact", href: assetPath("#contact") },
];
const isCurrent = (href: string) => !href.includes('#') && Astro.url.pathname.replace(/\/$/, '') === href.replace(/\/$/, '');
---

<header class="site-header sticky top-0 z-50" data-site-header>
  <nav class="site-nav mx-auto max-w-6xl px-5 sm:px-6 lg:px-8" aria-label="Primary navigation">
    <a href={assetPath("")} class="nav-brand" aria-label={`${profile.name} home`}>
      <img class="nav-logo-image" src={assetPath("my-icon.png")} alt="" width="1280" height="1280" />
      <span class="brand-wordmark"><span class="brand-name">Amiru</span><span class="brand-role">Open to opportunities</span></span>
    </a>

    <div class="nav-links hidden lg:flex">
      {navItems.map((item) => (
        <a class="nav-link" href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a>
      ))}
    </div>

    <a href={assetPath(profile.cvPath)} class="nav-hire desktop-hire" download>Download CV <Download size={16} aria-hidden="true" /></a>

    <button
      class="nav-menu-toggle inline-flex items-center justify-center lg:hidden"
      type="button"
      aria-label="Open navigation menu"
      aria-expanded="false"
      aria-controls="mobile-navigation"
      data-menu-toggle
    >
      <Menu class="h-5 w-5 data-[state=open]:hidden" aria-hidden="true" stroke-width={2} data-menu-open-icon />
      <X class="hidden h-5 w-5" aria-hidden="true" stroke-width={2} data-menu-close-icon />
    </button>
  </nav>

  <div id="mobile-navigation" class="hidden border-t border-white/10 bg-[#0a0e27] lg:hidden" data-mobile-menu>
    <div class="mx-auto grid max-w-6xl gap-1 px-5 py-4">
      {navItems.map((item) => (
        <a class="mobile-nav-link" href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined} data-mobile-link>
          {item.label}
        </a>
      ))}
      <a href={assetPath(profile.cvPath)} class="nav-hire mt-3 justify-self-start" download data-mobile-link>Download CV <Download size={16} aria-hidden="true" /></a>
    </div>
  </div>
</header>

<script>
  const menu = document.querySelector("[data-mobile-menu]");
  const button = document.querySelector("[data-menu-toggle]");
  const openIcon = document.querySelector("[data-menu-open-icon]");
  const closeIcon = document.querySelector("[data-menu-close-icon]");

  if (menu instanceof HTMLElement && button instanceof HTMLButtonElement && openIcon instanceof SVGElement && closeIcon instanceof SVGElement) {
    function setOpen(isOpen) {
      menu.classList.toggle("hidden", !isOpen);
      button.setAttribute("aria-expanded", String(isOpen));
      button.setAttribute("aria-label", isOpen ? "Close navigation menu" : "Open navigation menu");
      openIcon.classList.toggle("hidden", isOpen);
      closeIcon.classList.toggle("hidden", !isOpen);
    }

    button.addEventListener("click", () => setOpen(menu.classList.contains("hidden")));
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && !menu.classList.contains("hidden")) {
        setOpen(false);
        button.focus();
      }
    });
    menu.querySelectorAll("[data-mobile-link]").forEach((link) => {
      link.addEventListener("click", () => setOpen(false));
    });
  }
</script>

<style>
  .site-header { background: rgb(10 14 39 / 96%); border-bottom: 1px solid #ffffff08; backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px); }
  .site-nav { display: flex; align-items: center; justify-content: space-between; gap: 32px; min-height: 84px; }
  .nav-brand { display: inline-flex; align-items: center; gap: 8px; flex-shrink: 0; color: #f1f5ff; text-decoration: none; }
  .nav-logo-image { display: block; width: 60px; height: 60px; flex-shrink: 0; object-fit: contain; filter: hue-rotate(245deg) saturate(.8); }
  .brand-wordmark { display: flex; flex-direction: column; gap: 4px; }
  .brand-name { font-family: "Allura", "Segoe Script", cursive; font-size: 36px; font-style: normal; font-weight: 400; line-height: 1; letter-spacing: 0; }
  .brand-role { font-size: 10px; font-weight: 500; line-height: 1.3; letter-spacing: .09em; text-transform: uppercase; color: #9aa7c5; }
  .nav-links { align-items: center; justify-content: center; gap: 26px; margin-left: auto; }
  .nav-link { position: relative; display: inline-flex; align-items: center; justify-content: center; min-height: 44px; padding-block: 12px; color: #9aa7c5; font-size: 13px; font-weight: 500; line-height: 1.4; transition: color .2s; }
  .nav-link:hover { color: #f5f7ff; }
  .nav-link[aria-current] { color: #93c5fd; }
  .nav-link::after { content: ''; position: absolute; left: 0; right: 0; bottom: 3px; height: 2px; border-radius: 2px; background: #93c5fd; transform: scaleX(0); transform-origin: left; transition: transform .2s; }
  .nav-link[aria-current]::after { transform: scaleX(1); }
  .nav-hire { display: inline-flex; justify-content: center; align-items: center; gap: 9px; min-height: 42px; padding: 10px 18px; border: 1px solid #93c5fd55; border-radius: 6px; background: transparent; color: #bfdbfe; font-size: 13px; font-weight: 600; white-space: nowrap; transition: background .2s, border-color .2s, color .2s; }
  .nav-hire:hover { background: #5b8cff0d; border-color: #93c5fd; color: #f5f7ff; }
  .nav-menu-toggle { width: 44px; height: 44px; border: 0; border-radius: 6px; color: #cbd5e1; background: transparent; cursor: pointer; }
  .nav-menu-toggle:hover, .nav-menu-toggle[aria-expanded="true"] { background: #ffffff05; color: #93c5fd; }
  .mobile-nav-link { display: block; padding: 13px 14px; border-radius: 6px; color: #a6b1cb; font-size: 15px; font-weight: 500; transition: background .2s, color .2s; }
  .mobile-nav-link:hover { color: #fff; background: #ffffff05; }
  .mobile-nav-link[aria-current] { color: #bfdbfe; background: #5b8cff0a; }
  @media (max-width: 1023px) { .site-nav { min-height: 72px; gap: 12px; } .desktop-hire { display: none; } }
  @media (max-width: 380px) { .nav-logo-image { width: 52px; height: 52px; } .brand-name { font-size: 32px; } }
</style>
<script>
  const sectionLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-site-header] .nav-link, [data-site-header] .mobile-nav-link')).filter(link => link.hash);
  const sections = sectionLinks.map(link => document.getElementById(link.hash.slice(1))).filter((section): section is HTMLElement => Boolean(section));
  const uniqueSections = [...new Set(sections)];
  if (uniqueSections.length) {
    const observer = new IntersectionObserver(entries => {
      const visible = entries.filter(entry => entry.isIntersecting).sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top)[0];
      if (!visible) return;
      document.querySelectorAll('[data-site-header] a[aria-current]').forEach(link => link.removeAttribute('aria-current'));
      sectionLinks.forEach(link => { if (link.hash === `#${visible.target.id}`) link.setAttribute('aria-current', 'location'); });
    }, { rootMargin: '-15% 0px -60% 0px', threshold: 0 });
    uniqueSections.forEach(section => observer.observe(section));
    const hero = document.querySelector('.hero-section');
    if (hero) new IntersectionObserver(entries => {
      if (!entries[0].isIntersecting) return;
      document.querySelectorAll('[data-site-header] a[aria-current]').forEach(link => link.removeAttribute('aria-current'));
      document.querySelectorAll<HTMLAnchorElement>('[data-site-header] .nav-link, [data-site-header] .mobile-nav-link').forEach(link => { if (link.textContent?.trim() === 'Home') link.setAttribute('aria-current', 'page'); });
    }, { threshold: .4 }).observe(hero);
  }
</script>
