---
import { BriefcaseBusiness, CalendarDays, Server, PanelsTopLeft, Database, ListFilter, Files, Bug } from "@lucide/astro";
import { getTechLogo } from "../utils/techLogos";
interface Props {
  item: {
    company: string; department: string; role: string; period: string;
    duration: string; project: string; summary: string;
    highlights: string[]; stack: string[];
    contributions?: { title: string; description: string }[];
  };
}
const { item } = Astro.props;
const icons = [Server, PanelsTopLeft, Database, ListFilter, Files, Bug];
---

<article class="experience-card">
  <header class="experience-header">
    <span class="experience-emblem"><BriefcaseBusiness size={26} aria-hidden="true" /></span>
    <div class="experience-identity">
      <p class="experience-company">{item.company}</p>
      <h3>{item.role}</h3>
      <p class="experience-department">{item.department}</p>
    </div>
    <div class="experience-dates"><span><CalendarDays size={15} aria-hidden="true" />{item.period}</span><p>{item.duration}</p></div>
  </header>
  <div class="experience-body">
    <div class="project-context"><p class="experience-label">The project</p><h4>{item.project}</h4><p class="project-summary">{item.summary}</p></div>
    <div class="contributions">
      {item.contributions ? item.contributions.map((contribution, index) => {
        const Icon = icons[index % icons.length];
        return <section class="contribution"><span class="contribution-icon"><Icon size={19} aria-hidden="true" /></span><div><h4>{contribution.title}</h4><p>{contribution.description}</p></div></section>;
      }) : <ul>{item.highlights.map(highlight => <li>{highlight}</li>)}</ul>}
    </div>
    <footer class="experience-stack"><p class="experience-label">Technologies used</p><ul>{item.stack.map(tech => <li><span class="stack-logo"><img src={getTechLogo(tech === "Java 17" ? "Java" : tech)} alt="" width="22" height="22" loading="lazy" /></span>{tech}</li>)}</ul></footer>
  </div>
</article>

<style>
  .experience-card { border: 1px solid var(--portfolio-border); border-radius: 20px; overflow: hidden; background: linear-gradient(135deg, #ffffff07, #ffffff03); }
  .experience-header { display: flex; align-items: flex-start; gap: 18px; padding: 30px 32px; border-bottom: 1px solid #ffffff0d; background: linear-gradient(110deg, #3b82f60b, transparent); }
  .experience-emblem { display: grid; place-items: center; flex-shrink: 0; width: 56px; height: 56px; border: 1px solid #60a5fa25; border-radius: 14px; background: #3b82f614; color: #93c5fd; }
  .experience-identity { min-width: 0; }
  .experience-company { font-size: 14px; font-weight: 600; color: #93c5fd; margin-bottom: 7px; }
  .experience-identity h3 { font-size: clamp(22px, 2.5vw, 28px); font-weight: 750; color: #f5f7ff; line-height: 1.3; letter-spacing: -.025em; }
  .experience-department { margin-top: 8px; color: var(--portfolio-muted); font-size: 14px; }
  .experience-dates { margin-left: auto; flex-shrink: 0; text-align: right; color: var(--portfolio-muted); font-size: 13px; }
  .experience-dates span { display: inline-flex; align-items: center; gap: 8px; padding: 7px 10px; border-radius: 7px; border: 1px solid #ffffff0d; background: #ffffff04; color: #cbd5e1; }
  .experience-dates p { margin-top: 9px; }
  .experience-body { padding: 30px 32px; }
  .experience-label { color: var(--portfolio-muted); font-size: 11px; font-weight: 600; letter-spacing: .12em; text-transform: uppercase; }
  .project-context h4 { font-size: 18px; color: #e0e7ff; font-weight: 650; margin-top: 9px; line-height: 1.4; }
  .project-summary { max-width: 75ch; margin-top: 12px; color: var(--portfolio-muted); font-size: 16px; line-height: 1.75; }
  .contributions { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 28px 36px; margin-block: 30px; }
  .contribution { display: flex; align-items: flex-start; gap: 12px; }
  .contribution-icon { display: grid; place-items: center; width: 33px; height: 33px; flex-shrink: 0; border-radius: 8px; color: #a5b4fc; background: #818cf80b; }
  .contribution h4 { margin-top: 4px; font-size: 15px; font-weight: 700; color: #e0e7ff; line-height: 1.5; }
  .contribution p { margin-top: 8px; font-size: 14px; line-height: 1.75; color: var(--portfolio-muted); }
  .experience-stack { border-top: 1px solid #ffffff0d; padding-top: 24px; }
  .experience-stack ul { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 13px; list-style: none; }
  .experience-stack li { display: flex; align-items: center; gap: 9px; padding: 7px 12px 7px 7px; border: 1px solid #ffffff12; border-radius: 9px; color: #cbd5e1; background: #ffffff03; font-size: 13px; font-weight: 500; }
  .stack-logo { display: grid; place-items: center; width: 29px; height: 29px; border-radius: 5px; background: #f8fafc; }
  .stack-logo img { object-fit: contain; }
  @media (max-width: 767px) { .experience-header { flex-wrap: wrap; padding: 24px; gap: 14px; } .experience-dates { margin-left: 0; width: 100%; text-align: left; display: flex; flex-wrap: wrap; align-items: center; gap: 10px; } .experience-dates p { margin: 0; } .experience-body { padding: 24px; } .contributions { grid-template-columns: 1fr; gap: 24px; } .contribution p { font-size: 15px; } }
  @media (max-width: 380px) { .experience-emblem { width: 42px; height: 42px; } .experience-header, .experience-body { padding: 20px; } .experience-identity { flex: 1; } }
</style>
